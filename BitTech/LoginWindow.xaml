<Window x:Class="BitTech.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitTech - Авторизация" Height="400" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BitTech" FontSize="28" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#2196F3"/>

            <TextBox x:Name="txtLogin" Padding="10" FontSize="14" Margin="0,0,0,15"
                     Text="Введите логин..." GotFocus="TxtLogin_GotFocus" LostFocus="TxtLogin_LostFocus"/>

            <Button Content="Войти как пользователь" Click="BtnLogin_Click" 
                    Background="#2196F3" Foreground="White" FontSize="14" Padding="10" Margin="0,0,0,10"/>

            <Button Content="Войти как ГОСТЬ" Click="BtnGuest_Click" 
                    Background="#FF9800" Foreground="White" FontSize="14" Padding="10" Margin="0,0,0,10"/>

            <!-- Новая кнопка регистрации -->
            <Button Content="Нет аккаунта? Зарегистрироваться" Click="BtnRegister_Click" 
                    Background="Transparent" BorderBrush="#2196F3" Foreground="#2196F3" 
                    FontSize="12" Padding="10" Margin="0,0,0,15"/>

            <TextBlock x:Name="lblError" Foreground="Red" HorizontalAlignment="Center" 
                       Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>