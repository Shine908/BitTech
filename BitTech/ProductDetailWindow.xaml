<Window x:Class="BitTech.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка товара" Height="550" Width="700" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: Изображение -->
        <Image x:Name="picProduct" Grid.Column="0" 
               Width="220" Height="220" Stretch="Uniform" 
               VerticalAlignment="Top" Margin="0,0,20,0"/>

        <!-- Правая колонка: Информация -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">

            <!-- Название -->
            <TextBlock x:Name="lblName" FontSize="24" FontWeight="Bold" 
                       TextWrapping="Wrap" Margin="0,0,0,15"/>

            <!-- Категория и Производитель -->
            <TextBlock x:Name="lblCategory" FontSize="14" Foreground="#555" Margin="0,0,0,5"/>
            <TextBlock x:Name="lblProducer" FontSize="14" Foreground="#555" Margin="0,0,0,20"/>

            <!-- БЛОК ЦЕНЫ (Исправленный) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                <!-- Старая цена (красная, зачеркнутая, видна только при скидке) -->
                <TextBlock x:Name="lblOldPrice" 
                           FontSize="18" Foreground="Red" TextDecorations="Strikethrough" 
                           VerticalAlignment="Center" Margin="0,0,15,0" Visibility="Collapsed"/>

                <!-- Новая цена (зеленая или черная) -->
                <TextBlock x:Name="lblPrice" 
                           FontSize="28" FontWeight="Bold" Foreground="#2E7D32" 
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Остаток -->
            <TextBlock x:Name="lblStock" FontSize="14" Margin="0,0,0,20"/>

            <!-- Описание -->
            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="lblDesc" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Комплектация -->
            <TextBlock Text="Комплектация:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="lblComplectation" TextWrapping="Wrap" Margin="0,0,0,30"/>

            <!-- Панель покупки (видна только авторизованным) -->
            <StackPanel x:Name="pnlBuy" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                <TextBox x:Name="txtQty" Width="60" Padding="5" Text="1" 
                         PreviewTextInput="TxtQty_PreviewTextInput" VerticalContentAlignment="Center"/>
                <Button Content="В корзину" Click="BtnAddToCart_Click" 
                        Background="#4CAF50" Foreground="White" Padding="15,8" Margin="15,0,0,0" FontSize="14"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>