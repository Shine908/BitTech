<Window x:Class="BitTech.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара" Height="580" Width="500" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock x:Name="lblTitle" Text="Добавление нового товара" 
                           FontSize="20" FontWeight="Bold" Foreground="#2196F3" 
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Название -->
                <TextBlock Text="Название:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtName" Padding="8" Margin="0,0,0,10"/>

                <!-- Категория и Производитель (в одну строку) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Категория:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbCategory" Padding="8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Производитель:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbProducer" Padding="8"/>
                    </StackPanel>
                </Grid>

                <!-- Цена и Количество (в одну строку) -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Цена (₽):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrice" Padding="8" PreviewTextInput="TxtNumeric_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Количество:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtQty" Padding="8" PreviewTextInput="TxtNumeric_PreviewTextInput"/>
                    </StackPanel>
                </Grid>

                <!-- Описание -->
                <TextBlock Text="Описание:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDesc" Padding="8" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Комплектация -->
                <TextBlock Text="Комплектация:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtComplectation" Padding="8" Margin="0,0,0,10"/>

                <!-- Изображение -->
                <TextBlock Text="Изображение:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtImagePath" IsReadOnly="True" Padding="8" Background="#F5F5F5"/>
                    <Button Content="📂 Выбрать файл..." Grid.Column="1" Click="BtnSelectImage_Click" 
                            Margin="5,0,0,0" Padding="10,8"/>
                </Grid>
                <Image x:Name="imgPreview" Height="100" Stretch="Uniform" Margin="0,0,0,15" 
                       HorizontalAlignment="Center" Visibility="Collapsed"/>

                <!-- Кнопки действий -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="💾 Сохранить" Click="BtnSave_Click" 
                            Background="#4CAF50" Foreground="White" FontSize="14" Padding="10"/>

                    <Button Content="❌ Отмена" Grid.Column="2" Click="BtnCancel_Click" 
                            Background="#9E9E9E" Foreground="White" FontSize="14" Padding="10"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>