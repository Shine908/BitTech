<Window x:Class="BitTech.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация в BitTech" 
        Height="480" Width="380" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">

            <!-- Заголовок (поменьше) -->
            <TextBlock Text="Создание аккаунта" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#4CAF50" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15"/>

            <!-- Поля ввода (компактные) -->
            <TextBlock Text="Фамилия:" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="txtFamilia" Padding="6" Margin="0,0,0,8" FontSize="13"/>

            <TextBlock Text="Имя:" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="txtImya" Padding="6" Margin="0,0,0,8" FontSize="13"/>

            <TextBlock Text="Отчество:" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="txtOtchestvo" Padding="6" Margin="0,0,0,8" FontSize="13"/>

            <TextBlock Text="Логин:" FontSize="12" Margin="0,0,0,2"/>
            <TextBox x:Name="txtNewLogin" Padding="6" Margin="0,0,0,15" FontSize="13"/>

            <!-- Кнопки (покомпактнее) -->
            <Button Content="Зарегистрироваться" 
                    Click="BtnRegister_Click" 
                    Background="#4CAF50" 
                    Foreground="White" 
                    FontSize="14" 
                    Padding="8" 
                    Margin="0,0,0,8"
                    Cursor="Hand"/>

            <Button Content="← Назад" 
                    Click="BtnBack_Click" 
                    Background="Transparent" 
                    BorderBrush="#CCC" 
                    Foreground="#666" 
                    FontSize="12" 
                    Padding="8"
                    Cursor="Hand"
                    Margin="0,0,0,5"/>

            <!-- Сообщение (минимальная высота, чтобы не ломать верстку) -->
            <TextBlock x:Name="lblMessage" 
                       HorizontalAlignment="Center" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center" 
                       FontWeight="Bold"
                       FontSize="12"
                       MinHeight="30" 
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>